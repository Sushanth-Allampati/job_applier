# Get a free key at https://developer.adzuna.com/ (covers India + many countries)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
ADZUNA_COUNTRY=in

# REQUIRED before deploying: a long random string used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_string

# Database URL:
# Local development: sqlite:///./job_assistant.db
# Production (Render PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./job_assistant.db

# CORS Allowed Origins: comma-separated list of allowed frontend origins, or * for open access.
# In production on Netlify, set to: https://your-site-name.netlify.app
ALLOWED_ORIGINS=*
